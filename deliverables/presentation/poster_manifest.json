    {
      "top": 862,
      "bottom": 916.6,
      "x": 72,
      "width": 757.8897637795277,
      "text": "Train-only transforms; equal timestamps stay together. History uses strictly earlier inputs, never labels. Already viewed test: retrospective, not a new blind test."
    },
    {
      "top": 722,
      "bottom": 746.7,
      "x": 855.8897637795277,
      "width": 757.8897637795277,
