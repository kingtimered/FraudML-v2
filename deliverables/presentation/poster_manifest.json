      "bottom": 812.2,
      "x": 855.8897637795277,
      "width": 757.8897637795277,
      "text": "<b>LR0</b> original numeric pipeline; <b>LR1</b> train-fitted 0.1-99.9% clipping; <b>LR2</b> same clipping + stronger L2 (C=0.1)."
    },
