    {
      "top": 1980,
      "bottom": 2094.4,
      "x": 72.0,
      "width": 485.2598425196851,
      "text": "Raw-feature audit: V323 train max 49, test max 1,411. LR0's top 443 contain 442 cases from two days. Distribution shifts and score contributions support a diagnosis, not a unique cause."
    },
    {
      "top": 1940,
      "bottom": 1966.0,
      "x": 585.2598425196851,
      "width": 489.2598425196851,
      "text": "MORE FEATURES CAN FAIL"
    },
    {
      "top": 1980,
      "bottom": 2065.8,
      "x": 585.2598425196851,
      "width": 485.2598425196851,
      "text": "History is not a guaranteed upgrade. Retain negative results and complete ablations; do not choose the test winner after inspection."
    },
    {
      "top": 1940,
      "bottom": 1966.0,
      "x": 1098.5196850393702,
      "width": 489.2598425196851,
      "text": "ROWS ARE NOT MONTHS"
    },
    {
      "top": 1980,
      "bottom": 2094.4,
      "x": 1098.5196850393702,
      "width": 485.2598425196851,
      "text": "590k rows support this ranking study; only 31 test day buckets limit small-effect and long-term claims. No real review costs, label arrival times or verified deployment benefit."
    },
    {
      "top": 2184,
      "bottom": 2207.4,
      "x": 52,
      "width": 250,
      "text": "REPRODUCIBILITY"
    },
